{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "PRN232-LMS-Super-Secret-Key-At-Least-32-Chars-Long!",
    "Issuer": "PRN232.LMS",
    "Audience": "PRN232.LMS.Clients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "students-route": {
        "ClusterId": "student-cluster",
        "Match": { "Path": "/api/students/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "courses-route": {
        "ClusterId": "course-cluster",
        "Match": { "Path": "/api/courses/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "enrollments-route": {
        "ClusterId": "course-cluster",
        "Match": { "Path": "/api/enrollments/{**catch-all}" },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": { "Address": "http://identity-service:8080" }
        }
      },
      "student-cluster": {
        "Destinations": {
          "student": { "Address": "http://student-service:8080" }
        }
      },
      "course-cluster": {
        "Destinations": {
          "course": { "Address": "http://course-service:8080" }
        }
      }
    }
  }
}
