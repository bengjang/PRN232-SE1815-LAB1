{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": { "Address": "http://localhost:8081" }
        }
      },
      "student-cluster": {
        "Destinations": {
          "student": { "Address": "http://localhost:8082" }
        }
      },
      "course-cluster": {
        "Destinations": {
          "course": { "Address": "http://localhost:8084" }
        }
      }
    }
  }
}
